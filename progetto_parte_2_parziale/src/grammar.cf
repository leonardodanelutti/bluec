-- Grammar definition for the Blue language
-- Adapted from the [documentation](https://www.crescenziogallo.it/unifg/SSIS/PLPA/2006-2007/lmobj/blue/resources/lang-manual/httoc.htm)

-- Blue has only single line comments
-- == comment removed from the grammar
comment "--";
-- Multi-line comments added to the grammar
comment "/*" "*/";

-- Blue identifiers differ from haskell identifiers
token BlueIdent ((letter | '_') (letter | digit | '_')*);

entrypoints Declarations;

-- PROGRAM
ProgramDecl.                    Declarations ::= ConstB VarB RoutB;

RoutineBlockEmpty.              RoutB ::= {- empty -}; -- Routine block can be empty
RoutineBlock.                   RoutB ::= "routines" [P];

separator P "";
FunDecl.                        P ::= FunD;
ProcDecl.                       P ::= ProcD;

-- VARS
VarBlockEmpty.                  VarB ::= {- empty -}; -- Var block can be empty
VarBlock.                       VarB ::= "var" [VarA];
VarDeclAss.                     VarA ::= [BlueIdent] ":" Type ":=" [RExpNE];
terminator nonempty VarA ";";
separator BlueIdent ",";

-- CONSTS
ConstBlockEmpty.                ConstB ::= {- empty -}; -- Const block can be empty
ConstBlock.                     ConstB ::= "const" [ConstA];
ConstDeclAss.                   ConstA ::= [BlueIdent] ":" PType ":=" [RExpNE];
terminator nonempty  ConstA ";";

rules PType ::= "Boolean" | "Integer" | "Real" | "String" | "Char";
rules CType ::= "Array" "<" Type ";" Integer ">" | "&" Type;
rules Type ::= PType | CType;

-- ROUTINES
Fun.                            FunD ::= BlueIdent "(" [Param] ")" "->" Type RoutBody BlueIdent;
FunEmpty.                       FunD ::= BlueIdent "->" Type RoutBody BlueIdent;
Proc.                           ProcD ::= BlueIdent "(" [Param] ")" RoutBody BlueIdent;
ProcEmpty.                      ProcD ::= BlueIdent RoutBody BlueIdent;
RoutParam.                      Param ::= Mode BlueIdent ":" Type;
separator Param ",";

RoutineBody.                    RoutBody ::=  "is" Declarations "do" [Statement] "end";
terminator Statement "";

rules Mode ::= "val" | "valres" | "ref" | {- empty -};

RoutineCall.                    RoutCall ::= BlueIdent "(" [RExp] ")";
-- RoutCall can be a BlueIdent but the rule below is redoundant because RExpr can be a
-- BlueIdent and RoutCall can only be a RExpr.
-- RoutineCallEmpty.               RoutCall ::= BlueIdent;

-- STATEMENTS
StatementAss.                   Statement ::= [LExp] ":=" [RExpNE] ";";
StatementRoutCall.              Statement ::= BlueIdent "(" [RExp] ")" ";";
StatementRoutEmptyCall.         Statement ::= BlueIdent ";";
StatementReturn.                Statement ::= "return" RExp ";";
StatementReturnEmpty.           Statement ::= "return" ";";
StatementContinue.              Statement ::= "continue" ";";
StatementIf.                    Statement ::= If "end" "if";
StatementLoop.                  Statement ::= Loop "end" "loop";
StatementTryCatch.              Statement ::= "try" Statement "catch" Statement "end" "try";
StatementThrow.                 Statement ::= "throw" "error" ";";

separator RExp ",";
separator LExp ",";
NotEmptyRExp.                   RExpNE ::= RExp;
separator nonempty RExpNE ",";

-- CONDITIONALS
CondIf.                         If ::= "if" RExp "then" [Statement];
CondIfElse.                     If ::= "if" RExp "then" [Statement] "else" [Statement];

-- INDETERMINATE ITERATION
LoopEntry.                      Loop ::= "loop" [Statement] [Exit];
LoopExit.                       Exit ::= "exit" "on" RExp ";" [Statement];
separator Exit "";

-- EXPRESSIONS
coercions RExp 7;
RExpOr.                         RExp ::= RExp "or" RExp1;
RExpAnd.                        RExp1 ::= RExp1 "and" RExp2;

RExpGt.                         RExp2 ::= RExp3 ">"  RExp3;
RExpLs.                         RExp2 ::= RExp3 "<"  RExp3;
RExpGe.                         RExp2 ::= RExp3 ">=" RExp3;
RExpLe.                         RExp2 ::= RExp3 "<=" RExp3;
RExpEq.                         RExp2 ::= RExp3 "=" RExp3;
RExpNe.                         RExp2 ::= RExp3 "<>" RExp3;

RExpPlus.                       RExp3 ::= RExp3 "+" RExp4;
RExpMinus.                      RExp3 ::= RExp3 "-" RExp4;

RExpMult.                       RExp4 ::= RExp4 "*" RExp5;
RExpDivReal.                    RExp4 ::= RExp4 "/" RExp5;
RExpDivInt.                     RExp4 ::= RExp4 "div" RExp5;
RExpMod.                        RExp4 ::= RExp4 "mod" RExp5;

RExpPow.                        RExp5 ::= RExp5 "^" RExp6;

RExpSign.                       RExp6 ::= "-" RExp7;
RExpNeg.                        RExp6 ::= "not" RExp7;
RExpRef.                        RExp6 ::= "&" LExp;

RExpInt.                        RExp7 ::= Integer;
RExpChar.                       RExp7 ::= Char;
RExpString.                     RExp7 ::= String;
RExpBool.                       RExp7 ::= Bool;
RExpDouble.                     RExp7 ::= Double;
RExpCall.                       RExp7 ::= RoutCall;
RExpLExp.                       RExp7 ::= LExp;
RExpArray.                      RExp7 ::= "[" [RExp] "]";

rules Bool ::= "true" | "false";

coercions LExp 1;
LExpDeref.                      LExp ::= "*" LExp;

LExpArrayDeref.                 LExp1 ::= LExp1 "[" RExp "]";
LExpBase.                       LExp1 ::= BlueIdent;
