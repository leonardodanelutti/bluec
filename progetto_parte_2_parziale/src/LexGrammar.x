-- | Single position of a token in the source file.
data PosnS = PnS !Int !Int !Int
  deriving (Eq, Ord)

-- | First and last position of a token in the source file.
data Posn = Pn PosnS PosnS
  deriving (Eq, Ord)

defaultPosn :: Posn
