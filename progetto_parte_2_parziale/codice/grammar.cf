-- Blue has only single line comments
-- (https://www.crescenziogallo.it/unifg/SSIS/PLPA/2006-2007/lmobj/blue/resources/lang-manual/blue0014.htm#E9E14).
-- == comment removed from the grammar
comment "--";
-- Multi-line comments added to the grammar
comment "/*" "*/";

-- Blue identifiers differ from haskell identifiers
-- (https://www.crescenziogallo.it/unifg/SSIS/PLPA/2006-2007/lmobj/blue/resources/lang-manual/blue0004.htm#E9E4).
token DeclIdent ((letter | '_') (letter | digit | '_')*) (':');
token DeclIdentNonLast ((letter | '_') (letter | digit | '_')*) (',');
token BlueIdent ((letter | '_') (letter | digit | '_')*);

entrypoints Program;

-- PROGRAM
ProgramDecl.                    Program ::= ConstB VarB [P];
separator P "";
FunDecl.                        P ::= FunD;
ProcDecl.                       P ::= ProcD;

-- separator nonempty BlueIdent ",";

-- VARS
VarBlockEmpty.                  VarB ::= {- empty -}; -- Var block can be empty
VarBlock.                       VarB ::= "var" [VarA];
VarDeclAss.                     VarA ::= [DeclIdentNonLast] DeclIdent Type ":=" [RExpNE];
terminator nonempty VarA ";";
separator DeclIdentNonLast "";

-- CONSTS
ConstBlockEmpty.                ConstB ::= {- empty -}; -- Const block can be empty
ConstBlock.                     ConstB ::= "const" [ConstA];
ConstDeclAss.                   ConstA ::= [DeclIdentNonLast] DeclIdent PType ":=" [RExpNE];
terminator nonempty  ConstA ";";

rules PType ::= "Boolean" | "Integer" | "Real" | "String" | "Char";
rules CType ::= "Array" "<" Type ";" Integer ">" | "&" Type;
rules Type ::= PType | CType;

-- ROUTINES
Fun.                            FunD ::= BlueIdent "(" [Param] ")" "->" "(" [Type] ")" RoutBody;
FunEmpty.                       FunD ::= BlueIdent "->" "(" [Type] ")" RoutBody;
Proc.                           ProcD ::= BlueIdent "(" [Param] ")" RoutBody;
ProcEmpty.                      ProcD ::= BlueIdent RoutBody;
RoutParam.                      Param ::= Mode Ident ":" PType;
separator Type ",";
separator Param ",";

RoutineBody.                    RoutBody ::=  "is" ConstB VarB "do" [Statement] "end" BlueIdent;
terminator Statement ";";

rules Mode ::= "val" | "valres" | "ref" | {- empty -};

RoutineCall.                    RoutCall ::= BlueIdent "(" [RExp] ")";
-- RoutineCallEmpty.               RoutCall ::= BlueIdent; TODO: this was removed because it is unused (RExpr can be a BlueIdent and RoutCall can only be a RExpr)

-- STATEMENTS
StatementAss.                   Statement ::= [LExp] ":=" [RExpNE];
StatementProcCall.              Statement ::= BlueIdent "(" [RExp] ")";
StatementProcEmptyCall.         Statement ::= BlueIdent;
StatementReturn.                Statement ::= "return" [RExp];
StatementContinue.              Statement ::= "continue";
StatementIf.                    Statement ::= If;
StatementLoop.                  Statement ::= Loop;
-- TODO: Case
separator RExp ",";
separator LExp ",";
NotEmptyRExp.                   RExpNE ::= RExp;
separator nonempty RExpNE ",";

-- CONDITIONALS
CondIf.                         If ::= "if" RExp "then" [Statement] "end" "if";
CondIfElse.                     If ::= "if" RExp "then" [Statement] "else" [Statement] "end" "if";

-- INDETERMINATE ITERATION
LoopEntry.                      Loop ::= "loop" [Statement] [Exit];
LoopExit.                       Exit ::= "exit" "on" "(" RExp ")" [Statement];
separator Exit "";

-- DETERMINATE ITERATION
-- TODO:

-- EXPRESSIONS
coercions RExp 9;
RExpOr.                         RExp ::= RExp "or" RExp1;
RExpAnd.                        RExp1 ::= RExp1 "and" RExp2;

RExpGt.                         RExp2 ::= RExp3 ">"  RExp3;
RExpLs.                         RExp2 ::= RExp3 "<"  RExp3;
RExpGe.                         RExp2 ::= RExp3 ">=" RExp3;
RExpLe.                         RExp2 ::= RExp3 "<=" RExp3;
RExpEq.                         RExp2 ::= RExp3 "=" RExp3;
RExpNe.                         RExp2 ::= RExp3 "<>" RExp3;

RExpPlus.                       RExp3 ::= RExp3 "+" RExp4;
RExpMinus.                      RExp3 ::= RExp3 "-" RExp4;

RExpMult.                       RExp4 ::= RExp4 "*" RExp5;
RExpDivReal.                    RExp4 ::= RExp4 "/" RExp5;
RExpDivInt.                     RExp4 ::= RExp4 "div" RExp5;
RExpMod.                        RExp4 ::= RExp4 "mod" RExp5;

RExpPow.                        RExp5 ::= RExp5 "^" RExp6;

RExpSign.                       RExp6 ::= "-" RExp7;
RExpNeg.                        RExp6 ::= "not" RExp7;
RExpRef.                        RExp6 ::= "&" LExp;

RExpInt.                        RExp9 ::= Integer;
RExpChar.                       RExp9 ::= Char;
RExpString.                     RExp9 ::= String;
RExpBool.                       RExp9 ::= Bool;
RExpDouble.                     RExp9 ::= Double;
RExpCall.                       RExp9 ::= RoutCall;
RExpLExp.                       RExp9 ::= LExp;
RExpArray.                      RExp9 ::= "Array" "[" [RExp] "]";

rules Bool ::= "true" | "false";

coercions LExp 1;
LExpDeref.                      LExp ::= "*" LExp;

LExpArrayDeref.                 LExp1 ::= LExp1 "[" RExp "]";
LExpBase.                       LExp1 ::= BlueIdent;

