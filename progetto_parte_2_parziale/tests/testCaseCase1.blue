-- This example should have no errors.
--
-- What does this example test:
-- - case statement

routines
    
    main() is
    var
        c: Integer := 2;
    do
        case c of
            1:
                c := c+1;
            2:
                c := c+2;
            3:
                c := c+3;
            else
                c := c+4;
        end case
        return;
    end main