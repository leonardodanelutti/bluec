-- This example should have no errors.
--
-- What does this example test:
-- - a generic program.

const
	a, d : Integer := 0, 1;
var
	b : Real := 1.0;
	x : Integer := 42;
	p : &Integer := &x;
	y : Integer := *(p);
routines
	main() is
	var
		a : Integer := d;
	do
		if (a > 0) then
			a := 0;
		b := 1.0;
		end if
		if (a > 0) then
			x := 0;
		end if
		if (a = 1) then
			a := 2;
		end if
	return;
	end
	main

-- Hello world utility-
-- Modified with rispect to TestCase1 to include a return statement for every flow of control
__util__(ref b: Boolean) ->String is
    const
        const1: String:="Hello world";
do
        if b then return const1;
        else
    return "";
        end if
	return "";
    end
    __util__
