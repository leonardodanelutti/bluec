-- This example should have no errors.
--
-- What does this example test:
-- - tries compatibility between bool and integer

var
    s: Boolean := true;
    c: Integer := 2;
    iterator: Array<Boolean;3> := [true, true, false];

routines
    main() is
        var
            x: Boolean := s and c;
        do
            for iter: Boolean in iterator do
                x := iter;
            end for
            return;
        end
    main
