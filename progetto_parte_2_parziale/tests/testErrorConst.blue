const 
    x : Integer := 5;
    y : Integer := if x > 0 then 10 else x + 1 end if;

routines
    main is
        const
            a: Integer := if f(x) > 0 then 
            10 else f(x) + 1 end if;
        do
        return;
    end main

    f(n : Integer) -> Integer is
        do
        return n * 2;
    end f
