-- This example should have some errors.
--
-- What does this example test:
-- - access to unbounded variables;
-- - assignments to constants;
-- - wrong function calls;
-- - missing return statements;
-- - comments;
-- - array out of bounds.

const
    a, d: Integer := 0, 1;
var
    _b:Real := 1.0;
    array: Array<Array<Real; 3>; 2> := [j*2 + i : i, j];

/***
MAIN/* FUNCTION
*/
routines main is
    var
        a: Integer:=c;
    do
        if (a > 0)
        then
            a:=0;
            b:=1.0;
        end if
        if a > 0 then d:=0; end if
        if a = 1 then 
            a:=2;
        end if
        -- wrong function call
        __util__(); end
main

-- Hello world utility-
__util__(ref b: Boolean) -> String is
    const
        const1: String:="Hello world";
        const2: Real := array[1][4];
do
        if b then return const1;
        else
    return "";
        end if end
    __util__