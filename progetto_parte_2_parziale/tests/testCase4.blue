-- This example should have no errors.
--
-- What does this example test:
-- - compound types.

var
    A: Array<Integer; 3> := [1, 2, 3];
    B: Array<Array<Integer; 2>; 2> := [[10, 20], [30, 40]];
    p: &Array<Integer; 3> := &A;
    r: &Integer := &(B[1][1]);        -- riferimento al valore 40
    q: &&Integer := &r;               -- doppio riferimento a Integer (cioè: pointer to pointer)

routines
    main is
    var
        x: Integer := (*p)[1];        -- A[1] = 2
        y: Integer := **q;            -- doppia dereferenziazione: **q = *(&r) = *r = 40
    do
        return;
    end main