-- This example should have an error.
--
-- What does this example test:
-- - missing the main procedure check;
-- - array initialization and access.

var
    A: Array<Integer; 3> := [1, 2, 3];
    B: Array<Array<Integer; 2>; 2> := [[10, 20], [30, 40]];
    p: &Array<Integer; 3> := &A;
    q: &Integer := &B[1][1];

routines
    test -> Integer
    is
    var
        x: Integer := (*p)[1];
        y: Integer := *q;
    do
        return x + y;
    end
    test