-- This example should have no errors.
--
-- What does this example test:
-- - array initialization and access.

var
    A: Array<Integer; 3> := [1, 2, 3];
    B: Array<Array<Integer; 2>; 2> := [[10, 20], [30, 40]];
    p: &Array<Integer; 3> := &A;
    q: &Integer := &B[1][1];

routines
    main is
    do
        test;
        return;
    end main

    test -> Integer
    is
    var
        x: Integer := (*p)[1];
        y: Integer := *q;
    do
        return x + y;
    end
    test