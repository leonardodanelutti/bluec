-- This example should have no errors.
--
-- What does this example test:
-- - The return presence in every flow of control.

routines
    main() is
    var
        e: Real := 33;
	do
        loop
            e := readReal();
            if e = 33
            then
                -- Inserting a return here without any exit on the loop guarantees that
                -- loops until it returns (potentially forever).
                return;
            end if
        end loop
	end main