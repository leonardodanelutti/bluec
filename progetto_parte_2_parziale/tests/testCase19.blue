-- This example should have no errors.
--
-- What does this example test:
-- - passing values by reference and valres

routines 

main is
var
    a: Integer := 1;
    c: Char := 'c';
do
    a := test(a, c);
	return;
end main

test(ref x: Integer, valres y: Char) -> Integer is
do
    if y = '?' then
        x := x + 1;
    end if
    return x;
end test