-- This example should have no errors.
--
-- What does this example test:
-- - foreach.

var
    s: Boolean := true;
    c: Integer := 2;
    iterator: Array<Boolean;3> := [true, true, false];

routines
    main() is
        var
            x: Boolean := s and c;
        do
            for iter in iterator do
                x := iter;
                iter := x;
            end for
            foo(iterator);
            return;
        end
    main

    foo(const iterator: Array<Boolean;3>) is
        do
            for iter in iterator do
                s := iter;
                -- Uncommenting the line below generates an error because iterator is read-only.
                --iter := s;
            end for
            main;
            return;
        end
    foo
