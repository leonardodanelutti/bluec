-- This example should have no errors.
-- 
-- What does this example test:
-- - try / catch statements
-- - branches of the try/catch return or throw

const
    s: Boolean := true;
    c: Integer := 2;

routines
    main() is
        var
            x: Boolean := s and c;
        do
            loop
                x := not x;
                try
                    if x then throw error; end if
                catch
                    x := not x;
                end try
                exit on x;
            end loop
            if x then
                x := foo;
            else
                return;
            end if
        end
    main

    foo -> Boolean is do throw error; end foo
